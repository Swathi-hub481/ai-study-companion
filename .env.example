# ---------------------------------------------------------------------------
# AI Study Companion — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml by default. Port 5433 (not 5432) avoids clashing with
# a native PostgreSQL service that may already be running on the host.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_study_companion?schema=public"

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
SESSION_TTL_DAYS=30
# Set to the public origin in production; used for secure cookie decisions.
APP_URL="http://localhost:3000"

# --- AI provider ------------------------------------------------------------
# Generation and embeddings are configured SEPARATELY, because no single provider does
# both: Groq serves models but has no embeddings API.
#
# Generation provider: "groq" | "openai" | "mock".
# "mock" returns deterministic output with no API key, but its embeddings are NOT
# semantic — retrieval matches nothing and the Tutor refuses every question. Use it for
# tests, CI, and offline development only.
AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Embedding provider: "local" | "openai" | "mock".
# "local" runs a small model in-process — no key, no per-query cost, no network after
# the first download. Changing AI_EMBED_MODEL changes the vector width, which requires
# a migration and `npm run reembed`.
AI_EMBED_PROVIDER="local"
AI_EMBED_MODEL="Xenova/all-MiniLM-L6-v2"
AI_EMBED_DIMENSIONS=384

# Alternative providers. NEVER put a real key in this file — it is committed.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Per-feature model routing. A cheaper model for extraction, a stronger one for tutoring.
AI_MODEL_TUTOR="openai/gpt-oss-120b"
AI_MODEL_QUIZ="openai/gpt-oss-120b"
AI_MODEL_GRADE="openai/gpt-oss-120b"
AI_MODEL_EXTRACT="openai/gpt-oss-120b"
AI_MODEL_RECOMMEND="openai/gpt-oss-120b"
AI_REQUEST_TIMEOUT_MS=60000

# --- Retrieval --------------------------------------------------------------
RETRIEVAL_TOP_K=6
# The threshold is specific to the embedding model: a query/passage pair scores very
# differently under 384-dim local vectors than under 1536-dim hosted ones. Recalibrate
# with `npm run diag:retrieval -- "question"` whenever AI_EMBED_MODEL changes.
RETRIEVAL_MIN_SCORE=0.14
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
CONVERSATION_WINDOW_TURNS=6

# --- Documents --------------------------------------------------------------
MAX_UPLOAD_MB=25
OCR_ENABLED=true
# A page yielding fewer than this many characters is treated as scanned → OCR.
OCR_MIN_CHARS_PER_PAGE=120

# --- Background processing --------------------------------------------------
JOB_MAX_ATTEMPTS=3
JOB_POLL_MS=2000
JOB_BACKOFF_BASE_MS=5000
JOB_LOCK_TIMEOUT_MS=300000

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Observability ----------------------------------------------------------
LOG_LEVEL="info"

# --- Seed / admin bootstrap -------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin12345"
SEED_USER_EMAIL="learner@example.com"
SEED_USER_PASSWORD="learner12345"
