// AI Study Companion — data model
//
// Design notes:
//  * `projectId` is the isolation boundary. Every project-scoped table carries it
//    directly (including Chunk, denormalized on purpose) so retrieval can filter in a
//    single indexed query and can never accidentally join across Projects.
//  * Mastery is derived from append-only ConceptEvidence rows, so growth analysis is a
//    real time series rather than a mutable counter.
//  * Job/ActivityEvent/AiRequest are the observability and reliability spine.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum MaterialStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum QuizMode {
  QUIZ
  ASSESSMENT
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_ENDED
}

enum RecommendationStatus {
  OPEN
  DONE
  DISMISSED
}

enum MasteryBand {
  IMPROVING
  STABLE
  NEEDS_ATTENTION
}

enum AiFeature {
  TUTOR
  QUIZ_GENERATE
  ANSWER_GRADE
  CONCEPT_EXTRACT
  EMBED
  RECOMMEND
  GROWTH_INSIGHT
  /// Evaluation suites. Separate from the features they exercise, so an evaluation call
  /// is never counted as learner traffic in the AI-usage views.
  EVAL
}

enum AiStatus {
  SUCCESS
  FAILED
}

enum JobType {
  MATERIAL_PROCESS
  KNOWLEDGE_EXTRACT
  MASTERY_UPDATE
  QUIZ_EVALUATE
  RECOMMEND_GENERATE
  CONTEXT_REFRESH
  EVAL_RUN
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  spaces         Space[]
  activityEvents ActivityEvent[]
  aiRequests     AiRequest[]

  @@index([role])
}

/// Server-side session. The browser only ever holds the opaque token in an
/// httpOnly cookie, so sessions are revocable and never trust client state.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Spaces & Projects
// ---------------------------------------------------------------------------

/// A broad learning area. Intentionally not restricted to preset categories.
model Space {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String
  color       String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects       Project[]
  activityEvents ActivityEvent[]

  @@index([userId])
}

/// A focused learning journey. The isolation boundary for materials, retrieval,
/// conversations, concepts, assessments, mastery, and activity.
model Project {
  id          String   @id @default(cuid())
  spaceId     String
  name        String
  description String
  goal        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  materials       Material[]
  chunks          Chunk[]
  concepts        Concept[]
  conceptEvidence ConceptEvidence[]
  conversations   Conversation[]
  quizzes         Quiz[]
  recommendations Recommendation[]
  learningContext LearningContext?
  activityEvents  ActivityEvent[]
  aiRequests      AiRequest[]

  @@index([spaceId])
}

// ---------------------------------------------------------------------------
// Materials & knowledge
// ---------------------------------------------------------------------------

model Material {
  id         String         @id @default(cuid())
  projectId  String
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  status     MaterialStatus @default(QUEUED)
  error      String?
  pageCount  Int?
  processedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks   Chunk[]
  concepts MaterialConcept[]

  @@index([projectId, status])
}

/// A retrievable passage. `page` enables citations that point back to the source.
model Chunk {
  id         String @id @default(cuid())
  projectId  String
  materialId String
  content    String
  page       Int?
  ord        Int
  tokenCount Int    @default(0)
  createdAt  DateTime @default(now())

  /// pgvector column. Not exposed on the Prisma client — read/written only through
  /// lib/rag/retrieve.ts and lib/rag/embed.ts via parameterized raw SQL. The width
  /// follows the configured embedding model (AI_EMBED_DIMENSIONS).
  embedding Unsupported("vector(384)")?

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, ord])
  @@index([projectId])
  @@index([materialId])
}

/// A named concept extracted from the Project's materials, with an estimated
/// mastery level. Mastery is an estimate that evolves as evidence arrives.
model Concept {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  mastery     Float    @default(0)
  importance  Float    @default(0.5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materials       MaterialConcept[]
  evidence        ConceptEvidence[]
  questions       QuizQuestion[]
  recommendations Recommendation[]

  @@unique([projectId, name])
  @@index([projectId, mastery])
}

model MaterialConcept {
  materialId String
  conceptId  String
  weight     Float  @default(1)

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([materialId, conceptId])
  @@index([conceptId])
}

/// Append-only mastery evidence. A mutable counter could not answer "is this
/// concept improving?", so every observation is retained.
model ConceptEvidence {
  id        String   @id @default(cuid())
  projectId String
  conceptId String
  /// Where the evidence came from: QUIZ_ANSWER | TUTOR_INTERACTION | ASSESSMENT.
  source    String
  score     Float
  weight    Float    @default(1)
  metadata  Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId, createdAt])
  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// Tutor
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  projectId String
  title     String
  /// Rolling summary of older turns. Lets the Tutor keep continuity without
  /// re-sending the entire transcript on every request.
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId, updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  /// Citations backing an assistant answer: [{ materialId, title, page, score }]
  citations      Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Assessment
// ---------------------------------------------------------------------------

model Quiz {
  id          String     @id @default(cuid())
  projectId   String
  mode        QuizMode   @default(QUIZ)
  status      QuizStatus @default(IN_PROGRESS)
  title       String?
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([projectId, status])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  quizId        String
  conceptId     String?
  type          QuestionType
  difficulty    Float        @default(0.5)
  prompt        String
  /// Multiple-choice options: [{ id, text }]
  options       Json?
  correctAnswer String?
  explanation   String?
  ord           Int
  createdAt     DateTime     @default(now())

  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  concept  Concept?     @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  answer   QuizAnswer?

  @@index([quizId, ord])
  @@index([conceptId])
}

model QuizAnswer {
  id               String   @id @default(cuid())
  questionId       String   @unique
  userAnswer       String
  isCorrect        Boolean?
  score            Float?
  /// Explanatory feedback naming what was understood and what is missing —
  /// never just a numeric score.
  feedback         String?
  conceptsCovered  Json?
  conceptsMissing  Json?
  reasoning        String?
  /// MULTIPLE_CHOICE grading is deterministic; open-ended is AI-graded.
  gradedBy         String
  createdAt        DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Mastery, growth, recommendations, persistent context
// ---------------------------------------------------------------------------

model Recommendation {
  id         String               @id @default(cuid())
  projectId  String
  conceptId  String?
  title      String
  body       String
  reason     String?
  priority   Float                @default(0.5)
  status     RecommendationStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept Concept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)

  @@index([projectId, status, priority])
}

/// Curated, persistent learner context — one row per Project. Holds summaries and
/// signals, never the raw transcript, so retrieval stays relevant instead of expensive.
model LearningContext {
  id               String   @id @default(cuid())
  projectId        String   @unique
  goals            Json?
  preferences      Json?
  strengths        Json?
  weaknesses       Json?
  repeatedMistakes Json?
  tutorSummary     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Events, AI observability, background jobs
// ---------------------------------------------------------------------------

/// Event-driven learning log. Written in the same transaction as the state change
/// it describes so analytics can never drift from the data.
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  spaceId   String?
  projectId String?
  /// PROJECT_CREATED | MATERIAL_UPLOADED | MATERIAL_READY | TUTOR_MESSAGE |
  /// QUIZ_STARTED | QUIZ_COMPLETED | ANSWER_GRADED | MASTERY_UPDATED |
  /// RECOMMENDATION_CREATED | UNSUPPORTED_QUESTION | JOB_FAILED
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  space   Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  // SetNull, not Cascade: deleting a Project must not erase the audit trail of what
  // happened in it. The event survives with the subject recorded in `payload`.
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

/// One row per AI call. This is what makes the PRD's investigation questions
/// answerable: latency, model, cost, tokens, and failure reason per feature.
model AiRequest {
  id               String    @id @default(cuid())
  userId           String
  projectId        String?
  feature          AiFeature
  provider         String
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  latencyMs        Int       @default(0)
  costUsd          Float     @default(0)
  status           AiStatus
  error            String?
  /// Hash of the prompt template version, so prompt changes can be correlated
  /// with quality/latency shifts.
  promptVersion    String?
  createdAt        DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SetNull so cost and latency history survives deletion of the Project it belongs to.
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([status, createdAt])
}

/// Durable background job. Claimed with `FOR UPDATE SKIP LOCKED`, so multiple
/// workers can run safely, and keyed by a unique idempotency key so re-enqueueing
/// the same logical work is a no-op.
model Job {
  id             String    @id @default(cuid())
  type           JobType
  status         JobStatus @default(PENDING)
  payload        Json
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  result         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  completedAt    DateTime?

  @@index([status, runAt])
}
