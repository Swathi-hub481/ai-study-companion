# ---------------------------------------------------------------------------
# Test environment.
#
# These are disposable LOCAL values, not secrets: the database is a throwaway
# container on localhost with a published dummy password, and the AI provider is
# the deterministic mock. Nothing here grants access to any real system, which is
# why this file is safe to commit while `.env` is not.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ai_study_companion_test?schema=public"

AUTH_SECRET="test-only-auth-secret-not-valid-outside-the-test-suite"
APP_URL="http://localhost:3000"
LOG_LEVEL="silent"

# Deterministic, schema-valid AI output — no API key, no network.
AI_PROVIDER="mock"
# Embeddings are mocked too, so a test run never downloads a model. The width must match
# the `Chunk.embedding` column (see chunk_embedding_local_dimensions).
AI_EMBED_PROVIDER="mock"
AI_EMBED_DIMENSIONS=384

# Test uploads land in their own directory, so a test run can never disturb, or be
# confused by, documents uploaded through the running application.
STORAGE_LOCAL_DIR="./storage/test"

# Smaller chunks keep the fixtures to a handful of rows and make the assertions about
# page isolation and overlap legible.
CHUNK_TARGET_TOKENS=60
CHUNK_OVERLAP_TOKENS=15

# OCR needs a language-data download on first use, so it is off by default in tests.
# The policy that decides when OCR is needed is unit-tested; the OCR integration
# itself is verified by a dedicated script.
OCR_ENABLED=false
